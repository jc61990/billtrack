# Copy to .env (Docker) or /etc/billtrack/billtrack.env (setup.sh). chmod 600. Never commit.
#
# Since 2.0 most settings (email, push, time zone, week start, 2FA policy, session length) are edited in
# Admin > Settings and stored encrypted in the database. Values below are only used as first-run defaults.

# ---- Required infrastructure ----
# Database key file (64 hex chars). setup.sh creates /etc/billtrack/db.key; Docker uses a secret.
# BT_DB_KEY_FILE=/etc/billtrack/db.key
# Keep true behind HTTPS. false ONLY for plain-HTTP LAN testing.
BT_COOKIE_SECURE=true
# Extra allowed origins if your proxy rewrites Host (comma separated)
BT_ALLOWED_ORIGINS=
# Calendar feed token (python -m app.manage gen-ics-token). Blank = feed disabled.
BT_ICS_TOKEN=
# Scheduler interval and API rate limit (requests per minute per IP)
BT_CHECK_INTERVAL_MIN=15
BT_RATE_LIMIT_PER_MIN=300
# Browser API traffic must use the encrypted channel. Leave true. (Bearer-token scripts are exempt.)
BT_REQUIRE_CHANNEL=true

# ---- First-run defaults (then managed in Admin > Settings) ----
BT_BASE_URL=
BT_TZ=America/Chicago
BT_WEEK_START=0
BT_DIGEST_WEEKDAY=0
BT_DIGEST_HOUR=7
BT_REQUIRE_2FA=false
BT_SESSION_DAYS=30
BT_IDLE_DAYS=7
BT_SMTP_HOST=
BT_SMTP_PORT=587
BT_SMTP_TLS=starttls
BT_SMTP_USER=
BT_SMTP_PASS=
BT_SMTP_FROM=
BT_NTFY_SERVER=https://ntfy.sh
BT_NTFY_TOKEN=
